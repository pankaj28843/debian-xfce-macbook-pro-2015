# systemd-logind configuration for MacBook Pro 2015
# Generated by Ansible - do not edit manually

[Login]
# Clamshell mode: ignore lid switch when docked (external display connected)
HandleLidSwitchDocked={{ lid_switch_docked }}
HandleLidSwitch={{ lid_switch_battery }}
HandleLidSwitchExternalPower={{ lid_switch_ac }}
LidSwitchIgnoreInhibited=no

# Idle suspend
IdleAction=suspend
IdleActionSec={{ idle_suspend_minutes }}min

# Other settings
HandlePowerKey=poweroff
HandleSuspendKey=suspend
HandleHibernateKey=hibernate
