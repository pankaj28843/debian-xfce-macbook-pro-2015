#!/bin/bash
# HiDPI and HDMI display configuration for MacBook Pro 2015 (MacBookPro12,1)
# Generated by Ansible - do not edit manually

# Set HiDPI for Retina display (2560x1600 @ 227 PPI = 144 DPI)
xrandr --dpi {{ retina_dpi }}

# Configure external HDMI display (4K TV @ 30Hz)
# Only apply if HDMI is connected
if xrandr | grep -q "{{ hdmi_output }} connected"; then
    # Set HDMI to 4K @ 30Hz
    xrandr --output {{ hdmi_output }} --mode {{ hdmi_mode }} --rate {{ hdmi_rate }}
    
    {% if clamshell_mode %}
    # Clamshell mode: disable internal display, use external only
    xrandr --output {{ internal_display }} --off
    {% else %}
    # Extended mode: internal + external
    xrandr --output {{ internal_display }} --auto --primary --output {{ hdmi_output }} --auto --right-of {{ internal_display }}
    {% endif %}
else
    # No external display: use internal at 1920x1200 for readability
    xrandr --output {{ internal_display }} --mode 1920x1200 --primary
fi