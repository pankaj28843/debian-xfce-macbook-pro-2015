# TLP configuration for MacBook Pro 2015 (MacBookPro12,1)
# Generated by Ansible - do not edit manually

# CPU frequency scaling
CPU_SCALING_GOVERNOR_ON_AC={{ tlp_cpu_governor_ac }}
CPU_SCALING_GOVERNOR_ON_BAT={{ tlp_cpu_governor_bat }}

# PCIe ASPM
PCIE_ASPM_ON_BAT={{ tlp_pcie_aspm_bat }}

# USB autosuspend
USB_AUTOSUSPEND={{ tlp_usb_autosuspend }}

# Runtime Power Management for PCI(e) devices
RUNTIME_PM_ON_AC=on
RUNTIME_PM_ON_BAT=auto
RUNTIME_PM_ALL=1

# Disable Wake On Lan
WOL_DISABLE=Y

# Battery charge thresholds (if supported)
# START_CHARGE_THRESH_BAT0=75
# STOP_CHARGE_THRESH_BAT0=80